---
import Layout from '@/layouts/Layout.astro';
import { codeToHtml } from 'shiki';
import {
  basePath,
  discordUrl,
  docsRoute,
  githubUrl,
  officialDocs,
  officialSite,
  twitterUrl,
} from '@/lib/shared';

const schemaCode = `import {
  pgTable, serial, text, timestamp, varchar,
} from 'drizzle-orm/pg-core';

export const users = pgTable('users', {
  id: serial('id').primaryKey(),
  name: text('name').notNull(),
  email: varchar('email', { length: 255 }).unique(),
  role: text('role').default('member').notNull(),
  createdAt: timestamp('created_at').defaultNow().notNull(),
});

export type User = typeof users.$inferSelect;`;

const queryCode = `import { eq, desc, sum } from 'drizzle-orm';
import { db } from './db';
import { orders, users } from './schema';

const rows = await db
  .select({ name: users.name, total: sum(orders.amount) })
  .from(users)
  .innerJoin(orders, eq(orders.userId, users.id))
  .where(eq(orders.status, 'paid'))
  .groupBy(users.name, users.id)
  .orderBy(desc(sum(orders.amount)))
  .limit(10);`;

const migrationCode = `CREATE TABLE "users" (
  "id" serial PRIMARY KEY NOT NULL,
  "name" text NOT NULL,
  "email" varchar(255),
  "role" text DEFAULT 'member' NOT NULL,
  "created_at" timestamp DEFAULT now() NOT NULL
);
--> statement-breakpoint
CREATE UNIQUE INDEX "users_email_idx" ON "users" ("email");`;

const inspectCode = `import { eq } from 'drizzle-orm';
import { db } from './db';
import { users } from './schema';

const statement = db
  .select({ id: users.id, name: users.name })
  .from(users)
  .where(eq(users.role, 'admin'))
  .toSQL();

// {
//   sql: 'select "id", "name" from "users" where "role" = $1',
//   params: ['admin']
// }`;

const stepSchema = `export const posts = pgTable('posts', {
  id: serial('id').primaryKey(),
  title: text('title').notNull(),
  body: text('body'),
  authorId: integer('author_id')
    .references(() => users.id),
});`;

const stepQuery = `const rows = await db
  .select({
    title: posts.title,
    author: users.name,
  })
  .from(posts)
  .leftJoin(users, eq(posts.authorId, users.id))
  .limit(20);`;

const stepKit = `$ bunx drizzle-kit generate
$ bunx drizzle-kit migrate`;

async function highlight(code: string, lang: 'ts' | 'sql' | 'bash') {
  return codeToHtml(code, { lang, theme: 'vesper' });
}

const [schemaHtml, queryHtml, migrationHtml, inspectHtml, stepSchemaHtml, stepQueryHtml, stepKitHtml] =
  await Promise.all([
    highlight(schemaCode, 'ts'),
    highlight(queryCode, 'ts'),
    highlight(migrationCode, 'sql'),
    highlight(inspectCode, 'ts'),
    highlight(stepSchema, 'ts'),
    highlight(stepQuery, 'ts'),
    highlight(stepKit, 'bash'),
  ]);

const features = [
  {
    n: '01',
    title: 'SQL 的直觉',
    desc: 'select、join、groupBy、window——与 SQL 一一对应。懂 SQL，就懂 Drizzle，不需要学习另一套查询语言。',
    icon: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
  },
  {
    n: '02',
    title: '端到端类型安全',
    desc: '从 schema 推断列类型与查询结果，IDE 自动补全贯穿始终。改动数据结构时，编译器会指出每一处受影响的位置。',
    icon: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    n: '03',
    title: '零代码生成',
    desc: 'schema 就是 TypeScript 代码。没有生成目录、没有守护进程、没有隐藏产物——导入即用，重构即生效。',
    icon: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  },
  {
    n: '04',
    title: '一份 schema，多种方言',
    desc: '为 PostgreSQL、MySQL、SQLite、SingleStore、Gel 提供核心适配，共享同一套查询 API 与类型体验。',
    icon: '<path d="M12 2C7.6 2 4 3.3 4 5s3.6 3 8 3 8-1.3 8-3-3.6-3-8-3z"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>',
  },
  {
    n: '05',
    title: '迁移全流程',
    desc: 'drizzle-kit 负责 generate、migrate、push 与 pull，把 schema 变更变成可审查、可版本化的 SQL 文件。',
    icon: '<path d="M14.7 6.3a4 4 0 0 0-5.3 5.3L3 18v3h3l6.4-6.4a4 4 0 0 0 5.3-5.3l-2.1 2.1-2.5-2.5 2.1-2.1z"/>',
  },
  {
    n: '06',
    title: '边缘就绪',
    desc: 'Cloudflare Workers 与 D1、Neon、Turso、Bun、Deno、PGlite——没有多余依赖，任意运行时都能轻装上线。',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18"/>',
  },
];

const databases = [
  'PostgreSQL',
  'MySQL',
  'SQLite',
  'Neon',
  'Supabase',
  'PlanetScale',
  'Cloudflare D1',
  'Turso',
  'Bun SQLite',
  'PGlite',
  'AWS Data API',
  'Gel',
  'SingleStore',
  'Expo SQLite',
  'Xata',
  'Vercel Postgres',
];

const quickLinks = [
  { title: '概览', desc: 'Drizzle 的设计哲学与核心概念', href: docsRoute },
  { title: '快速开始', desc: '十分钟接入 PostgreSQL', href: `${docsRoute}/quickstart` },
  { title: 'Schema', desc: '用 TypeScript 描述数据表', href: `${docsRoute}/schema` },
  { title: '查询', desc: '查询构建器与 SQL 运算符', href: `${docsRoute}/queries` },
  { title: '迁移', desc: '从 schema 变更到 SQL 文件', href: `${docsRoute}/migrations` },
  { title: '常见问题', desc: '方言、版本与常见误区', href: `${docsRoute}/faq` },
];
---

<Layout
  title="Drizzle ORM 中文文档"
  description="Drizzle ORM 官方文档中文版：活在 TypeScript 里的 SQL。声明式 schema、类 SQL 查询构建器、零代码生成，类型安全贯穿始终。"
>
  <div class="landing flex min-h-screen flex-col bg-[#08090a] text-[#f1f3ed]">
    <a href="#main-content" class="skip-link">跳到主要内容</a>
    <header
      data-site-header
      class="sticky top-0 z-50 border-b border-white/[0.07] bg-[#08090a]/80 backdrop-blur-xl"
    >
      <div
        data-header-inner
        class="mx-auto flex h-[60px] w-full max-w-[1200px] items-center gap-8 px-5 md:px-8"
      >
        <a href={basePath} class="flex shrink-0 items-center gap-2.5" aria-label="Drizzle 首页">
          <img src={`${basePath}logo.svg`} alt="Drizzle" width="116" height="22" class="h-[21px] w-auto" />
        </a>

        <nav class="site-nav shrink-0" aria-label="主导航">
          <button
            type="button"
            data-menu-button
            class="menu-button grid size-8 place-items-center rounded-lg border border-white/10 text-white/70"
            popovertarget="site-menu"
            popovertargetaction="toggle"
            aria-controls="site-menu"
            aria-label="菜单"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
          <ul id="site-menu" class="site-menu" popover="auto">
            <li><a href={docsRoute}>文档</a></li>
            <li><a href={`${docsRoute}/quickstart`}>快速开始</a></li>
            <li><a href={`${docsRoute}/ecosystem`}>生态</a></li>
            <li><a href={`${docsRoute}/faq`}>问答</a></li>
            <li class="nav-github"><a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a></li>
          </ul>
        </nav>

        <div class="ml-auto flex shrink-0 items-center gap-2.5">
          <a
            href={githubUrl}
            target="_blank"
            rel="noreferrer"
            class="hidden items-center gap-2 rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-white/70 transition hover:border-white/25 hover:text-white sm:flex"
          >
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            <span>36.3k</span>
          </a>
          <a
            href={`${docsRoute}/quickstart`}
            class="rounded-lg bg-brand px-3.5 py-1.5 text-xs font-semibold text-ink transition hover:brightness-105"
          >
            开始使用
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <section class="landing-section overflow-hidden">
        <div class="landing-grid absolute inset-0 -z-10"></div>
        <div class="brand-glow absolute -top-40 left-1/2 -z-10 h-[560px] w-[900px] -translate-x-1/2"></div>

        <div class="mx-auto w-full max-w-[1200px] px-5 pb-16 pt-16 md:px-8 lg:pb-20 lg:pt-24">
          <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_520px] lg:gap-16">
            <div class="min-w-0">
              <div class="rise">
                <span
                  class="eyebrow-pill inline-flex items-center gap-2 rounded-full px-3 py-1 font-mono text-[11px] tracking-wide"
                >
                  <span class="relative inline-flex size-1.5 rounded-full bg-brand"></span>
                  v1 Beta · Apache-2.0 · 开源
                </span>
              </div>

              <h1
                id="main-content"
                tabindex="-1"
                class="rise rise-1 mt-6 text-[46px] font-semibold leading-[1.04] tracking-[-0.04em] sm:text-6xl lg:text-[72px]"
              >
                活在 <span class="text-white/90">TypeScript</span><br />
                里的 <span class="relative text-brand">SQL<span
                    class="absolute -bottom-1 left-0 h-[3px] w-full rounded-full bg-brand/30"
                  ></span></span>
              </h1>

              <p class="rise rise-2 mt-6 max-w-[540px] text-[15.5px] leading-[1.8] text-white/55">
                Drizzle 是一个「有头脑」的无头 TypeScript ORM。声明式 schema、类 SQL 的查询构建器、
                零代码生成——类型安全贯穿从建表到查询的每一步。
              </p>

              <div class="rise rise-3 mt-8 flex flex-wrap items-center gap-3">
                <a
                  href={`${docsRoute}/quickstart`}
                  class="inline-flex items-center rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-ink transition hover:brightness-105"
                >
                  开始使用
                </a>
                <a
                  href={docsRoute}
                  class="inline-flex items-center gap-2 rounded-lg border border-white/12 bg-white/[0.03] px-5 py-2.5 text-sm font-medium text-white/80 transition hover:border-white/25 hover:text-white"
                >
                  浏览文档
                </a>
                <a
                  href={githubUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm text-white/55 transition hover:text-white"
                >
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path
                      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                    ></path>
                  </svg>
                  36.3k Stars
                </a>
              </div>

              <div class="rise rise-4 mt-7 flex flex-wrap items-center gap-3">
                <div
                  class="flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.025] py-2 pl-3 pr-2 font-mono text-xs text-white/65"
                >
                  <span class="text-brand">$</span>
                  <span>bun add drizzle-orm</span>
                  <button
                    type="button"
                    command="--copy"
                    commandfor="install-cmd"
                    aria-label="复制安装命令"
                    class="grid min-h-6 min-w-6 place-items-center rounded text-white/40 transition hover:bg-white/8 hover:text-white"
                  >
                    <span class="icon-copy" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                        <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
                      </svg>
                    </span>
                    <span class="icon-check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m5 13 4 4L19 7"></path>
                      </svg>
                    </span>
                    <span class="icon-alert" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v5M12 16.5v.5"></path>
                      </svg>
                    </span>
                  </button>
                  <span id="install-cmd" class="sr-only">bun add drizzle-orm</span>
                </div>
                <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-white/50">
                  支持 npm · pnpm · yarn · bun
                </span>
              </div>
            </div>

            <div class="rise rise-2 relative min-w-0">
              <div class="code-window-glow absolute -inset-10 -z-10"></div>
              <div class="code-window overflow-hidden rounded-xl" data-tabs>
                <div class="flex items-center border-b border-white/10 bg-white/[0.015] pl-3.5">
                  <div class="flex items-center gap-1.5 pr-3" aria-hidden="true">
                    <span class="size-2.5 rounded-full bg-white/12"></span>
                    <span class="size-2.5 rounded-full bg-white/12"></span>
                    <span class="size-2.5 rounded-full bg-brand/50"></span>
                  </div>
                  <div
                    role="tablist"
                    focusgroup="tablist nomemory"
                    aria-label="代码示例"
                    class="code-tablist flex min-w-0 items-center overflow-x-auto"
                  >
                    <button
                      type="button"
                      role="tab"
                      id="tab-schema"
                      data-tab="schema"
                      aria-selected="true"
                      focusgroupstart
                      class="code-tab shrink-0 px-3 py-2.5 font-mono text-[11.5px]"
                    >
                      schema.ts
                    </button>
                    <button
                      type="button"
                      role="tab"
                      id="tab-query"
                      data-tab="query"
                      aria-selected="false"
                      class="code-tab shrink-0 px-3 py-2.5 font-mono text-[11.5px]"
                    >
                      query.ts
                    </button>
                    <button
                      type="button"
                      role="tab"
                      id="tab-migration"
                      data-tab="migration"
                      aria-selected="false"
                      class="code-tab shrink-0 px-3 py-2.5 font-mono text-[11.5px]"
                    >
                      migration.sql
                    </button>
                  </div>
                  <button
                    type="button"
                    command="--copy"
                    commandfor="panel-schema"
                    data-copy-window
                    aria-label="复制当前代码示例"
                    class="ml-auto mr-2.5 grid min-h-7 min-w-7 shrink-0 place-items-center rounded-md text-white/40 transition hover:bg-white/8 hover:text-white"
                  >
                    <span class="icon-copy" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                        <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
                      </svg>
                    </span>
                    <span class="icon-check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m5 13 4 4L19 7"></path>
                      </svg>
                    </span>
                    <span class="icon-alert" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v5M12 16.5v.5"></path>
                      </svg>
                    </span>
                  </button>
                </div>

                <div class="landing-code line-numbers min-h-[312px]">
                  <div
                    role="tabpanel"
                    id="panel-schema"
                    aria-labelledby="tab-schema"
                    data-panel="schema"
                    class="code-tab-panel"
                    set:html={schemaHtml}
                  ></div>
                  <div
                    role="tabpanel"
                    id="panel-query"
                    aria-labelledby="tab-query"
                    data-panel="query"
                    class="code-tab-panel"
                    hidden="until-found"
                    set:html={queryHtml}
                  ></div>
                  <div
                    role="tabpanel"
                    id="panel-migration"
                    aria-labelledby="tab-migration"
                    data-panel="migration"
                    class="code-tab-panel"
                    hidden="until-found"
                    set:html={migrationHtml}
                  ></div>
                </div>

                <div
                  class="flex items-center justify-between border-t border-white/[0.07] bg-white/[0.015] px-3.5 py-2 font-mono text-[10px] uppercase tracking-[0.12em] text-white/50"
                >
                  <span class="inline-flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-brand/70"></span>
                    drizzle-orm · type-safe
                  </span>
                  <span>UTF-8 · LF</span>
                </div>
              </div>
            </div>
          </div>

          <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-white/[0.07] pt-8 lg:mt-20 lg:grid-cols-4">
            <div>
              <dt class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-white/50">GitHub Stars</dt>
              <dd class="mt-2 font-mono text-[26px] tracking-tight text-white">36.3k</dd>
            </div>
            <div>
              <dt class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-white/50">代码生成</dt>
              <dd class="mt-2 font-mono text-[26px] tracking-tight text-white">0</dd>
            </div>
            <div>
              <dt class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-white/50">数据库驱动</dt>
              <dd class="mt-2 font-mono text-[26px] tracking-tight text-white">15+</dd>
            </div>
            <div>
              <dt class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-white/50">开源协议</dt>
              <dd class="mt-2 font-mono text-[26px] tracking-tight text-white">Apache-2.0</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="landing-section border-t border-white/[0.07]">
        <div class="mx-auto w-full max-w-[1200px] px-5 py-20 md:px-8 lg:py-24">
          <div class="max-w-[640px]">
            <p class="mono-label">// 为什么选择 Drizzle</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-[-0.025em] sm:text-[40px] sm:leading-[1.15]">
              SQL 的掌控感，<br class="hidden sm:block" />TypeScript 的安全感。
            </h2>
            <p class="mt-4 text-[15px] leading-7 text-white/50">
              没有黑盒 DSL，也没有运行时魔法。Drizzle 把 SQL 原样交还给你，同时让类型系统覆盖每一处细节。
            </p>
          </div>

          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              features.map((feature) => (
                <article class="feature-card card-surface rounded-xl p-6 transition-colors">
                  <div class="flex items-start justify-between">
                    <span class="grid size-9 place-items-center rounded-lg border border-brand/20 bg-brand/[0.07] text-brand">
                      <svg
                        viewBox="0 0 24 24"
                        width="17"
                        height="17"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={feature.icon}
                      />
                    </span>
                    <span class="font-mono text-[11px] text-white/50">{feature.n}</span>
                  </div>
                  <h3 class="mt-5 text-[16.5px] font-medium tracking-[-0.01em] text-white/90">{feature.title}</h3>
                  <p class="mt-2 text-[13.5px] leading-[1.75] text-white/55">{feature.desc}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="landing-section border-t border-white/[0.07] bg-[#0a0c0b]">
        <div class="mx-auto grid w-full max-w-[1200px] items-center gap-12 px-5 py-20 md:px-8 lg:grid-cols-2 lg:gap-20 lg:py-24">
          <div>
